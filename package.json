{
	"name": "glass-garden",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"vendor": "node scripts/vendor-assets.mjs",
		"predev": "npm run vendor",
		"dev": "vite dev --port 3000",
		"prebuild": "npm run vendor",
		"build": "vite build",
		"preview": "vite preview --host --port 3000",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"postinstall": "patch-package"
	},
	"devDependencies": {
		"@battlefieldduck/xterm-svelte": "^2.3.0",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.9",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.34.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@thisux/sveltednd": "^0.7.0",
		"@types/node": "^24",
		"@uiw/codemirror-theme-dracula": "^4.25.11",
		"@vivari/core": "^1.0.0",
		"@xterm/xterm": "^6.0.0",
		"@xyflow/svelte": "^1.6.3",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"formsnap": "^2.0.1",
		"globals": "^17.6.0",
		"idb": "^8.0.3",
		"mode-watcher": "^1.1.0",
		"nanoid": "^6.0.1",
		"paneforge": "^1.0.2",
		"patch-package": "^8.0.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"runed": "^0.37.1",
		"shadcn-svelte": "^1.5.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-codemirror-editor": "^2.1.0",
		"svelte-sonner": "^1.1.1",
		"svelte-toolbelt": "^0.10.6",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"zod": "^4.4.3"
	}
}
