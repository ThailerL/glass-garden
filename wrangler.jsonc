// glass.garden's own deployment. Built with `ADAPTER=cloudflare npm run build`; the Docker image
// self-hosters run is the Node build and ignores this
{
	"name": "glass-garden",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-10",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
		// Without this the default serves /about/ and redirects /about to it, contradicting the
		// content site's trailingSlash and the sitemap, which both write the bare path
		"html_handling": "drop-trailing-slash"
	},
	"vars": {
		"PUBLIC_ORIGIN": "https://glass.garden"
	},
	"routes": [
		{ "pattern": "glass.garden/*", "zone_name": "glass.garden" },
		{ "pattern": "embed.glass.garden/*", "zone_name": "glass.garden" },
		// Needs a proxied *.embed DNS record and a certificate naming *.embed.glass.garden
		{ "pattern": "*.embed.glass.garden/*", "zone_name": "glass.garden" }
	]
}
