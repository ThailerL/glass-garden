---
import '../styles/global.css';
// The app's own icon, imported rather than linked at /favicon.svg so it resolves under this
// project's dev server too, which serves none of the app's static folder
import faviconUrl from '../../../static/favicon.svg?url';
import { jsonLd, trimOrigin } from '$lib/page-metadata';
import { aboutPath, challengesPath } from '../paths';

// The last crumb carries no path: Google reads it off the URL that served the page
type Crumb = { name: string; path?: string };

// `title` is for the search result, `shareTitle` for a feed, when they read differently
type Props = {
	title: string;
	description: string;
	shareTitle?: string;
	image?: string;
	narrow?: boolean;
	trail?: Crumb[];
};

// The app's own card, which is a screenshot of a canvas running, unless a page draws its own
const {
	title,
	description,
	shareTitle = title,
	image = '/og.png',
	narrow = false,
	trail
} = Astro.props;
// Scrapers reject a relative og:image, and this build knows no address unless it was given one
const origin = trimOrigin(import.meta.env.PUBLIC_ORIGIN);
// Running text wants a narrower page than the home page's embedded canvas does
const width = narrow ? 'max-w-3xl' : 'max-w-page';
// Relative, since a static build cannot know the origin it will be served from
const canonical = Astro.url.pathname;

// Without this Google builds the trail from the URL, where "about" is only the mount segment.
// Every page sits under the site root, so the layout supplies that crumb rather than each page
function breadcrumbScript(crumbs: Crumb[], crumbOrigin: string): string {
	return jsonLd({
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [{ name: 'Glass Garden', path: aboutPath }, ...crumbs].map(
			({ name, path }, index) => ({
				'@type': 'ListItem',
				position: index + 1,
				name,
				// Absolute, since Google reads a string `item` as an @id and rejects a relative one
				...(path ? { item: `${crumbOrigin}${path}` } : {})
			})
		)
	});
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href={faviconUrl} />
		<!-- Rendered above the title, which is why a share title names only the page -->
		<meta property="og:site_name" content="Glass Garden" />
		<meta property="og:title" content={shareTitle} />
		<meta property="og:description" content={description} />
		<!-- Everything that needs an absolute URL, so a build given no address writes none of it -->
		{origin && (
			<Fragment>
				<meta property="og:image" content={`${origin}${image}`} />
				<meta name="twitter:card" content="summary_large_image" />
				{trail && <Fragment set:html={breadcrumbScript(trail, origin)} />}
			</Fragment>
		)}
		<!-- A meta cannot read a CSS var: these restate --background from src/lib/theme.css -->
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafbfd" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0e1116" />
		<!-- Before paint, so the page never flashes the other theme -->
		<script is:inline>
			if (matchMedia('(prefers-color-scheme: dark)').matches) {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<body class="min-h-dvh">
		<header class="border-b">
			<nav class={`mx-auto flex ${width} flex-wrap items-center gap-x-6 gap-y-2 px-4 py-4`}>
				<a href={aboutPath} class="flex items-center gap-2 font-semibold tracking-tight">
					<img src={faviconUrl} alt="" class="size-6" />
					Glass Garden
				</a>
				<div class="ml-auto flex items-center gap-4">
					<a href={challengesPath} class="text-sm text-muted-foreground hover:text-foreground">
						Challenges
					</a>
					<a href="/" class="text-sm text-muted-foreground hover:text-foreground">
						Open Glass Garden
					</a>
					<!-- The app's sidebar draws the same mark, so the two headers match -->
					<a
						href="https://github.com/ThailerL/glass-garden"
						target="_blank"
						rel="noreferrer"
						title="Glass Garden on GitHub"
						class="shrink-0 text-muted-foreground hover:text-foreground"
					>
						<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class="size-4">
							<path d="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656"></path>
						</svg>
						<span class="sr-only">Glass Garden on GitHub</span>
					</a>
				</div>
			</nav>
		</header>

		<main class={`mx-auto flex ${width} flex-col gap-12 px-4 py-12`}>
			<slot />
		</main>

		<footer class="border-t">
			<div
				class={`mx-auto flex ${width} flex-wrap gap-x-6 gap-y-2 px-4 py-6 text-sm text-muted-foreground`}
			>
				<a href="/" class="hover:text-foreground">
					Open Glass Garden
				</a>
				<a href="https://github.com/ThailerL/glass-garden" class="hover:text-foreground">
					GitHub
				</a>
				<a
					href="https://github.com/ThailerL/glass-garden/blob/main/LICENSE"
					class="hover:text-foreground"
				>
					AGPL-3.0
				</a>
			</div>
		</footer>
	</body>
</html>
