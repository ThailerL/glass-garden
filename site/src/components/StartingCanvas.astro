---
import type { CanvasDocument } from '../../../src/lib/project-document';
import { layoutCanvas, NODE_SIZE } from '../canvas-layout';
import { nodeSubtitle, resourceOf } from '../resources';

type Props = { nodes: CanvasDocument['nodes']; edges: CanvasDocument['edges'] };

const { nodes, edges } = Astro.props;

// The same placement the link card's drawing uses, so the two pictures of a challenge agree
const { placed, wires, width, height } = layoutCanvas({ nodes, edges });
---

<div class="canvas overflow-x-auto rounded-xl border p-8">
	<div class="relative mx-auto" style={`width: ${width}px; height: ${height}px`}>
		<svg class="absolute inset-0" {width} {height} aria-hidden="true">
			{wires.map((wire) => (
				<line {...wire} stroke="var(--muted-foreground)" stroke-width="1.5" />
			))}
		</svg>
		{placed.map(({ node, left, top }) => (
			<div
				class="node absolute flex flex-col items-center justify-center gap-0.5 bg-card px-2 text-center"
				style={`left: ${left}px; top: ${top}px; width: ${NODE_SIZE}px; height: ${NODE_SIZE}px`}
			>
				<svg
					class="size-9 text-resource-icon"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
					set:html={resourceOf(node.type).icon}
				/>
				<span class="text-[0.8125rem] leading-tight font-medium">{node.config.name}</span>
				<span class="text-[11px] leading-tight text-muted-foreground">
					{nodeSubtitle(node.type, node.config)}
				</span>
			</div>
		))}
	</div>
</div>

<style>
	/* The canvas as the app draws it, so the diagram is recognisable once the reader opens it */
	.canvas {
		background-color: var(--canvas);
		background-image: radial-gradient(var(--canvas-pattern) 1px, transparent 1px);
		background-size: 18px 18px;
	}

	.node {
		border: var(--node-border);
		border-radius: var(--node-radius);
		box-shadow: var(--node-shadow);
	}
</style>
